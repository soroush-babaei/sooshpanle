# ── امنیت پنل ─────────────────────────────────────────────
SECRET_KEY=change-me-to-64-random-hex-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ── دامنه و اشتراک ────────────────────────────────────────
PUBLIC_DOMAIN=panel.example.com        # دامنه‌ای که CDN می‌گذرد (برای WS)
WS_PATH=/ws
SUB_BASE_URL=                          # خالی = https://PUBLIC_DOMAIN

# ── Reality (برای تولید: docker run --rm teddysun/xray xray x25519) ──
REALITY_SNI=www.datadoghq.com
REALITY_PRIVKEY=
REALITY_PUBKEY=

# ── تونل Cloudflare ───────────────────────────────────────
CF_TUNNEL_TOKEN=

# ── سرویس آمار (آدرس از دید پنل) ──────────────────────────
STATS_URL=http://soosh-stats:9000/stats
